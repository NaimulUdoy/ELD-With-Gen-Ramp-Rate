Multi-Period Economic Dispatch with Generator Ramp-Rate Constraints
C o m p i l a t i o n


   2   
   3  Sets
   4      g 'Generators' / g1, g2, g3 /
   5      t 'Time periods (hours)' / t1*t24 /;
   6   
   7  Parameters
   8      a(g) 'Quadratic cost coefficient ($/MW^2)' / g1 0.12, g2 0.08, g3 0.07 /
   9      b(g) 'Linear cost coefficient ($/MW)'     / g1 20.0, g2 25.0, g3 30.0 /
  10      c(g) 'Constant cost coefficient ($)'       / g1 500.0, g2 400.0, g3 200.0 /
  11   
  12      Pmin(g) 'Minimum generation capacity (MW)' / g1 20.0, g2 30.0, g3 40.0 /
  13      Pmax(g) 'Maximum generation capacity (MW)' / g1 150.0, g2 200.0, g3 300.0 /
  14   
  15      UR(g)   'Ramp-up limit (MW/hour)'          / g1 30.0, g2 40.0, g3 50.0 /
  16      DR(g)   'Ramp-down limit (MW/hour)'        / g1 30.0, g2 40.0, g3 50.0 /
  17   
  18      P0(g)   'Initial generator output before t1 (MW)' / g1 50.0, g2 80.0, g3 100.0 /;
  19   
  20  * Hourly load profile (24-hour daily demand curve)
  21  Parameter Demand(t) 'Hourly system load demand (MW)' /
  22      t1  220, t2  200, t3  190, t4  180, t5  200, t6  230,
  23      t7  280, t8  340, t9  400, t10 450, t11 480, t12 490,
  24      t13 470, t14 460, t15 450, t16 480, t17 520, t18 550,
  25      t19 530, t20 500, t21 440, t22 380, t23 310, t24 250
  26  /;
  27   
  28  Variables
  29      Z       'Total generation cost over 24 hours ($)'
  30      P(g,t)  'Power output of unit g at time period t (MW)';
  31   
  32  * Enforce individual unit capacity bounds
  33  P.lo(g,t) = Pmin(g);
  34  P.up(g,t) = Pmax(g);
  35   
  36  Equations
  37      cost_obj         'Total daily generation cost'
  38      power_balance(t) 'Hourly demand balance constraint'
  39      ramp_up_init(g)  'Ramp-up constraint for the initial time step (t1)'
  40      ramp_dn_init(g)  'Ramp-down constraint for the initial time step (t1)'
  41      ramp_up(g,t)     'Ramp-up limit for subsequent periods (t2 to t24)'
  42      ramp_dn(g,t)     'Ramp-down limit for subsequent periods (t2 to t24)';
  43   
  44  * Objective Function: Sum of costs over all generators and time periods
  45  cost_obj..
  46      Z =E= sum((g,t), a(g)*sqr(P(g,t)) + b(g)*P(g,t) + c(g));
  47   
  48  * Power Balance Constraint for each hour
  49  power_balance(t)..
  50      sum(g, P(g,t)) =E= Demand(t);
  51   
  52  * Ramp-Up Limits
  53  ramp_up_init(g)..
  54      P(g,'t1') - P0(g) =L= UR(g);
  55   
  56  ramp_up(g,t)$(ord(t) > 1)..
  57      P(g,t) - P(g,t-1) =L= UR(g);
  58   
  59  * Ramp-Down Limits
  60  ramp_dn_init(g)..
  61      P0(g) - P(g,'t1') =L= DR(g);
  62   
  63  ramp_dn(g,t)$(ord(t) > 1)..
  64      P(g,t-1) - P(g,t) =L= DR(g);
  65   
  66  * Model Declaration & Solve Statement
  67  Model dynamic_economic_dispatch / all /;
  68   
  69  Solve dynamic_economic_dispatch using nlp minimizing Z;
  70   
  71  * Display Output Tables in .lst File
  72  Display P.l, Z.l;
  73   
  74  * --- AUTOMATED CSV EXPORT FOR PLOTTING ---
  75  File results / dispatch_results.csv /;
  76  results.pw = 32767;
  77  put results;
  78  put "Generator,TimePeriod,PowerOutput_MW" /;
  79  loop((g,t),
  80      put g.tl, ",", t.tl, ",", P.l(g,t):0:2 /;
  81  );
  82  putclose results;


